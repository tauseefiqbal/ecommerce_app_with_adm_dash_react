{
  "name": "@repo/db",
  "version": "0.0.1",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "db:generate": "node --env-file=../../.env ./node_modules/prisma/build/index.js generate",
    "db:push": "node --env-file=../../.env ./node_modules/prisma/build/index.js db push",
    "db:migrate": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate dev",
    "db:studio": "node --env-file=../../.env ./node_modules/prisma/build/index.js studio",
    "db:seed": "node --env-file=../../.env prisma/seed.mjs",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.3.1",
    "prisma": "^6.4.1",
    "typescript": "^5.9.2"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  }
}
